# Apify API key — get from https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# App login password — choose anything you want
APP_PASSWORD=your_secure_password_here

# App secret — random string used to sign session cookies (generate: openssl rand -hex 32)
APP_SECRET=replace_with_random_32_char_string_here
