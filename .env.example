# ── Apify ────────────────────────────────────────────────────
# Get from: https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# ── Anthropic ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Supabase ──────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → your project → Settings → API
# Use the Project URL and service_role key (NOT the anon key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App Auth ──────────────────────────────────────────────────
# Choose any password you want for the login screen
APP_PASSWORD=your_secure_password_here
# Random secret for signing session cookies (run: openssl rand -hex 32)
APP_SECRET=replace_with_random_32_char_string_here
